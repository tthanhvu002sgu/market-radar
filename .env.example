# Market Radar Configuration
DB_PATH=data/market_radar.db
HISTORICAL_DAYS=365
MIN_COVERAGE_PCT=0.95
UPDATE_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO

# Alpaca Market Data API (nguồn quote OFI — tạo key miễn phí tại alpaca.markets,
# paper account). Cần set cả trên GitHub Actions secrets (workflow OFI collector)
# và Render env (trang OFI live) nếu muốn bật tính năng.
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
